{
  "id": "wf-databricks-sample",
  "name": "Ascerta Databricks Sample",
  "nodes": [
    {
      "id": "trigger-1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {}
    },
    {
      "id": "agent-1",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [600, 300],
      "parameters": {
        "text": "={{ $json.input }}",
        "options": {}
      }
    },
    {
      "id": "dbx-chat-1",
      "name": "Ascerta Databricks (Proxy)",
      "type": "@ascerta/n8n-nodes-ascerta.lmChatAscertaDatabricks",
      "typeVersion": 1,
      "position": [600, 500],
      "parameters": {
        "endpointName": {
          "mode": "name",
          "value": "databricks-claude-sonnet-4-6"
        },
        "deployedModel": {"mode": "name", "value": "claude-sonnet-4-6"},
        "cloudProvider": "aws",
        "options": {
          "temperature": 0.5,
          "maxTokens": 1024
        },
        "useCaseName": "={{ $workflow.name.replaceAll(' ', '-') }}",
        "useCaseId": "={{ 'databricks/' + $parameter.endpointName.value + '/' + $execution.id }}",
        "useCaseStep": "={{ $node.name }}"
      },
      "credentials": {
        "ascertaApi": {
          "id": "cred-ascerta-1",
          "name": "Ascerta API"
        },
        "ascertaDatabricksApi": {
          "id": "cred-dbx-1",
          "name": "Databricks PAT"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]]
    },
    "Ascerta Databricks (Proxy)": {
      "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]]
    }
  }
}
